# Neon Postgres connection string.
# Create a project at https://console.neon.tech and copy the pooled connection string.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public origin of this app (must match in production, e.g. https://lumen.your-subdomain.workers.dev).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Resend API key. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Published template ID or alias; must define RESET_URL and sender/subject/reply-to.
RESEND_PASSWORD_RESET_TEMPLATE_ID=password-reset
